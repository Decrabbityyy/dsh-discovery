{
  // Type-check-only project for the host-side packages: src AND specs, no emit.
  // The build's "tsc -b" covers src alone and tsdown transpiles without checking,
  // so without this gate a type error in a spec file stays invisible until
  // vitest happens to execute it. Sibling workspace packages map to their
  // sources so the gate works on a clean checkout, mirroring the vitest aliases.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "paths": {
      "dsh-llm-discovery": ["./llm-discovery/src/index.ts"],
      "dsh-llm-discovery/engine": ["./llm-discovery/src/engine.ts"],
      "dsh-llm-discovery/vocabulary": ["./llm-discovery/src/vocabulary.ts"],
      "dsh-llm-discovery/catalog/models-dev": ["./llm-discovery/src/catalog/models-dev.ts"],
      "dsh-llm-discovery/catalog/service": ["./llm-discovery/src/catalog/service.ts"]
    }
  },
  "include": [

    "llm-discovery/src",
    "llm-discovery/tests",
    "llm-dynamic-provider/src",
    "llm-dynamic-provider/tests"
  ]
}
