{
  // Self-contained client compiler shape: harness types resolve from
  // node_modules (@alpha/@next); only the workspace discovery package is a
  // project reference. Browser library API + React JSX, no ambient node types.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "lib/types",
    // 增量信息放在 lib 之外：发布产物只该有 JS 与声明。
    "tsBuildInfoFile": "./.tsbuildinfo/tsconfig.tsbuildinfo"
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../llm-discovery"
    }
  ]
}
